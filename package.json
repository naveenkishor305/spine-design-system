{
  "name": "spine-design-system",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=spine-docs",
    "build": "npm run build --workspace=@naveenkishor305/spine-ui && npm run build --workspace=spine-docs",
    "build:ui": "npm run build --workspace=@naveenkishor305/spine-ui",
    "start": "npm run start --workspace=spine-docs",
    "lint": "npm run lint --workspaces --if-present",
    "capture:renders": "npm run capture:renders --workspace=spine-docs"
  }
}
